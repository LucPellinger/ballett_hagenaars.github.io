#!/usr/bin/env sh
# Enforces the commit convention (see CONTRIBUTING.md):
#   <type>(#<ticket>): <summary>     e.g. feat(#12): add gallery lightbox
#   <type>: <summary>                e.g. chore: bump dependencies
msg=$(head -n1 "$1")

# Allow merge / revert / fixup commits generated by git
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(feat|fix|hotfix|chore|docs|style|refactor|perf|test|build|ci|content|revert)(\(#[0-9]+\))?!?: .{3,}$'
if ! echo "$msg" | grep -Eq "$pattern"; then
  echo "✗ Invalid commit message:"
  echo "    $msg"
  echo ""
  echo "  Use:  <type>(#<ticket>): <summary>   or   <type>: <summary>"
  echo "  Types: feat fix hotfix chore docs style refactor perf test build ci content revert"
  echo "  Example: feat(#12): add lightbox to gallery"
  exit 1
fi
