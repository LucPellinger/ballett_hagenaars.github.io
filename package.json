{
  "name": "ballett-hagenaars",
  "description": "Website der Ballettschule Hagenaars, Haßloch – multi-page PWA (React + Vite + TypeScript)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn typecheck && yarn lint && yarn test && yarn content:check",
    "content:check": "node scripts/check-content.mjs",
    "content:check:strict": "node scripts/check-content.mjs --strict",
    "ticket:new": "node scripts/ticket.mjs new",
    "ticket:move": "node scripts/ticket.mjs move",
    "board": "node scripts/ticket.mjs board",
    "hooks:install": "git config core.hooksPath .githooks",
    "postinstall": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
